# Git ignore patterns for research pipeline

# Data (immutable raw stored locally)
data/raw/
data/interim/
data/processed/*.db
data/processed/*.parquet
data/processed/*.csv
!data/processed/.gitkeep
!data/external/.gitkeep

# Environment
.env
.env.*
!.env.example
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Secrets
*.pem
credentials.json

# Downloaded external repositories (recreate with seed-github-data)
data/external/github/

# Local graphify state; portable graph and report remain versioned
graphify-out/.*
graphify-out/cache/
graphify-out/memory/
graphify-out/reflections/
graphify-out/converted/
graphify-out/manifest.json
graphify-out/cost.json
